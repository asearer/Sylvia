# Sylvia Project Configuration Template
# Copy this file to .env and fill in the values

# -------------------------------------------------------------------------
# Communication Service Credentials
# -------------------------------------------------------------------------
# Discord Bot Token (Required for Discord integration)
DISCORD_TOKEN=your_discord_bot_token_here

# Matrix Configuration (Required for Matrix integration)
MATRIX_HOMESERVER=https://matrix.org
MATRIX_BOT_USER=@your_bot:matrix.org
MATRIX_BOT_PASSWORD=your_bot_password
MATRIX_ROOM_ID=!your_room_id:matrix.org

# -------------------------------------------------------------------------
# Service Configuration
# -------------------------------------------------------------------------
# Port for the Personality Engine API
PERSONALITY_ENGINE_PORT=5001

# Port for the Sylvia App (Streamlit)
SYLVIA_APP_PORT=5000

# -------------------------------------------------------------------------
# Model Configuration (Future Use)
# -------------------------------------------------------------------------
# Path to local LLM model (e.g., for LlamaCpp)
# LLM_MODEL_PATH=/path/to/model.gguf

# Path to local STT model (e.g., Whisper)
# STT_MODEL_PATH=/path/to/whisper-base
